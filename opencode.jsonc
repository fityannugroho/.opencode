{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "plan": {
      "disabled": true
    },
    "explore": {
      "steps": 8
    },
    "general": {
      "steps": 10
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/tmp*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/keyrings/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/tmp*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.local/share/keyrings/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.local/share/keyrings/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*python *",
      "effect": "deny"
    }, // use `uv`
    {
      "action": "shell",
      "resource": "*python3 *",
      "effect": "deny"
    }, // use `uv`
    {
      "action": "shell",
      "resource": "*npx *",
      "effect": "deny"
    }, // use `pnpx`
    {
      "action": "shell",
      "resource": "*pnpx *",
      "effect": "allow"
    },
    // pnpx contains the substring "npx", must be allowed explicitly
    // === prevent security risks ===
    {
      "action": "shell",
      "resource": "docker* prune *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "podman* prune *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*/.ssh*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*/.local/share/keyrings*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "io.github.upstash/context7": {
        "type": "local",
        "command": [
          "bunx",
          "@upstash/context7-mcp@latest"
        ]
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      },
      "shadcn": {
        "type": "local",
        "command": [
          "bunx",
          "shadcn@latest",
          "mcp"
        ],
        "disabled": true
      }
    }
  },
  "providers": {
    "openrouter": {
      "models": {
        "openrouter/free": {
          "name": "OpenRouter Free",
          "limit": {
            "context": 200000,
            "output": 131072
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
